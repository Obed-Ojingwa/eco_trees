# Copy this file to backend/.env. Replace placeholders before running.
# Get the Session pooler host and project ref from Supabase Dashboard > Connect.
# Apply backend/supabase/setup.sql once first. It creates the ecotrees database role.
# URL-encode password characters. Never expose database URLs in frontend code.
ENVIRONMENT=development
# Supabase Dashboard > Connect > Session pooler. For direct connections, use the
# direct host/port shown by Supabase instead. DB_URL is the least-privilege app role.
DB_URL=postgresql://ecotrees.<PROJECT_REF>:<URL_ENCODED_ECOTREES_PASSWORD>@<SESSION_POOLER_HOST>:5432/postgres?sslmode=require
DB_MIGRATION_URL=postgresql://postgres.<PROJECT_REF>:<URL_ENCODED_POSTGRES_PASSWORD>@<SESSION_POOLER_HOST>:5432/postgres?sslmode=require
# The values below are local/demo defaults, not production credentials.
JWT_SECRET=development-only-change-me
JWT_EXPIRY_MINUTES=60
JWT_COOKIE_NAME=ecotrees_session
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
INGEST_TOKEN=replace-with-a-local-random-token
BANK_API_BASE=http://localhost:9000/v1
GATEWAY_KEY=local-mock-key
BANK_GET_RETRIES=3
# Demo-only local mock; live Xtradot finance schemas are unverified and fail closed.
PAYMENT_BACKEND=mock
ALLOW_MOCK_PAYMENTS=true
FORGE_WEBHOOK_SECRET=replace-with-a-random-secret-at-least-32-bytes
PAYOUT_ENCRYPTION_KEY=replace-with-a-different-random-secret-at-least-32-bytes
PUBLIC_BASE_URL=http://127.0.0.1:8000
WEBHOOK_URL=http://127.0.0.1:8000/hooks/forge
TREASURY_ACCOUNT=0123456790
CHECKOUT_FEE_BPS=0
PAYOUT_FEE_BPS=0
ORDER_EXPIRY_MINUTES=30
FARMER_LEVEL_THRESHOLDS=0:Seedling,500:Sapling,1500:Canopy,5000:Forest Guardian
API_BASE_URL=http://127.0.0.1:8000
MAX_PHOTO_BYTES=8388608
BANK_RPM_BUDGET=45
MIN_PLOT_AREA_HA=0.01
MAX_PLOT_AREA_HA=1000
DENSITY_MIN_PER_HA=50
DENSITY_MAX_PER_HA=2500
PHOTO_GPS_TOLERANCE_M=50
PHOTO_ACCURACY_LIMIT_M=50
PHOTO_POINTS_WEEKLY_CAP=500
MONITORING_MIN_OBSERVATIONS=4
MONITORING_ROLLING_N=3
MONITORING_REFERENCE_WINDOW_DAYS=365
MONITORING_WATCH_DROP=0.15
MONITORING_FREEZE_DROP=0.30
MONITORING_FREEZE_CONSECUTIVE=2
MONITORING_RECOVER_CONSECUTIVE=3
MONITORING_MIN_VALID_PIXELS=1
EXISTING_FOREST_NDVI=0.7
CARBON_MIN_VALID_PIXELS=5
CARBON_BATCH_MIN_TONNES=1
CARBON_PARAM_VERSION=illustrative-v1
CARBON_SIGNING_KEY=replace-with-a-local-random-signing-key
CARBON_SIGNING_KEY_ID=local-development
REGISTRY_BACKEND=mock
REGISTRY_XTRADOT_ENABLED=false